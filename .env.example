# Ledgr Environment Variables
# Copy this file to .env and fill in your values.
# These are Supabase PUBLIC keys — safe to commit the example, not the .env

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Never add service_role key here — keep it server-side only
